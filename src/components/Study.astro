      <ellipse cx="300" cy="300" rx="80" ry="210" />
      <path d="M300 90V510" />
      <g clip-path="url(#orb)"><ellipse cx="300" cy="170" rx="210" ry="48" /><ellipse cx="300" cy="235" rx="210" ry="68" /><ellipse cx="300" cy="300" rx="210" ry="78" /><ellipse cx="300" cy="365" rx="210" ry="68" /><ellipse cx="300" cy="430" rx="210" ry="48" /></g>
