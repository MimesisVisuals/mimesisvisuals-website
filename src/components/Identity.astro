---
import Brand from './Brand.astro';
import Study from './Study.astro';
import { site } from '../config/site';
import type { Copy } from '../i18n';
interface Props { copy: Copy }
const { copy } = Astro.props;
---
<header id="top" class="site-header wrap">
  <Brand label={copy.home} />
  <nav aria-label={copy.navigation}>
    <a href="#studio">{copy.nav.studio}</a>
    <a href="#expertise">{copy.nav.expertise}</a>
    <a href="#contact">{copy.nav.contact}<span aria-hidden="true"> ↗</span></a>
  </nav>
</header>
<main id="main">
  <section class="intro wrap" aria-labelledby="intro-heading">
    <div class="intro-copy">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>{copy.intro.eyebrow}</p>
      <h1 id="intro-heading">{copy.intro.title}</h1>
      <p class="intro-description">{copy.intro.description}</p>
      <a class="text-link" href="#studio">{copy.intro.action}<span aria-hidden="true"> ↓</span></a>
    </div>
    <div class="intro-art"><Study /><p class="art-caption">{copy.intro.caption}</p></div>
  </section>
  <section id="studio" class="studio section wrap" aria-labelledby="studio-heading">
    <p class="eyebrow section-label">{copy.studio.label}</p>
    <div class="section-content"><h2 id="studio-heading">{copy.studio.title}</h2>
      <div class="studio-text">{copy.studio.paragraphs.map(text => <p>{text}</p>)}</div>
    </div>
  </section>
  <section id="expertise" class="expertise section wrap" aria-labelledby="expertise-heading">
    <div class="section-heading"><p class="eyebrow">{copy.expertise.label}</p><h2 id="expertise-heading">{copy.expertise.title}</h2></div>
    <div class="expertise-list">{copy.expertise.items.map(item => (
      <article class="expertise-item"><span class="item-number" aria-hidden="true">{item.number}</span><h3>{item.title}</h3><div><p>{item.text}</p><p class="tags">{item.tags}</p></div></article>
    ))}</div>
  </section>
  <section id="contact" class="contact" aria-labelledby="contact-heading"><div class="wrap contact-inner">
    <p class="eyebrow">{copy.contact.label}</p>
    <div><h2 id="contact-heading">{copy.contact.title}</h2><p class="contact-description">{copy.contact.description}</p>
      {site.email ? <a class="contact-link" href={`mailto:${site.email}`} aria-label={`${copy.contact.action}: ${site.email}`}>{site.email}<span aria-hidden="true"> ↗</span></a> : <p class="contact-pending">{copy.contact.pending}</p>}
    </div>
  </div></section>
</main>
<footer class="site-footer wrap"><p>© {new Date().getFullYear()} {site.name}. {copy.footer.rights}</p><div><span lang="en">{copy.footer.language}</span><a href="#top">{copy.footer.top} ↑</a></div></footer>
